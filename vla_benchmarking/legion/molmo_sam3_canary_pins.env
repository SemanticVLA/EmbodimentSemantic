# Immutable runtime pins for the MolmoPoint + SAM3.1 canary.
#
# This file is metadata, not a secret-bearing environment file. The checkpoint
# digest is verified before model construction and must match this value.
RUNTIME_MANIFEST_FORMAT=molmo-sam3-canary-runtime.v1
PYTHON_VERSION=3.12
CUDA_FAMILY=12.8
TORCH_VERSION=2.10.0
TORCHVISION_VERSION=0.25.0

SAM3_REPOSITORY=https://github.com/facebookresearch/sam3.git
SAM3_SOURCE_COMMIT=96914d2425f90a64f45ca977c2b5165418099543
SAM3_CHECKPOINT_SHA256=0567debeec80ba4ac6369540c6c248025283cb3ff2b92827509e57e2b3541cb6
SAM3_CHECKPOINT_SHA256_PREFIX=0567de

MOLMOPOINT_MODEL=allenai/MolmoPoint-8B
MOLMOPOINT_MODEL_REVISION=188130f961c8e0888a34e11121a1423c461a01ba
MOLMOPOINT_PROMPT_ID=rim_downward_approach

# Direct dependencies from the pinned SAM3 pyproject plus the MolmoPoint
# runtime. The launcher uses the validated Legion Python environment unless a
# dedicated CANARY_PYTHON is provided by the runtime setup job.
SAM3_DEPENDENCY_SPEC='timm>=1.0.17,numpy>=1.26,<2,tqdm,ftfy==6.1.1,regex,iopath>=0.1.10,typing_extensions,huggingface_hub'
MOLMOPOINT_TRANSFORMERS_VERSION=4.57.1
MOLMOPOINT_DEPENDENCY_SPEC='transformers==4.57.1,accelerate,safetensors,einops,einops-exts,sentencepiece,tokenizers,cached_path>=1.6.4'
